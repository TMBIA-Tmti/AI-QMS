# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
chainlit_*.log
main_agent_*.log

# Data (user-generated)
data/*.json
!data/.gitkeep
uploads/*
!uploads/.gitkeep
markdown_storage/documents/*
!markdown_storage/documents/.gitkeep
markdown_storage/metadata/*.json
!markdown_storage/metadata/.gitkeep
markdown_storage/ocr_artifacts/*
!markdown_storage/ocr_artifacts/.gitkeep
markdown_storage/index/*
!markdown_storage/index/.gitkeep

# Cache
.ruff_cache/
.sisyphus/
.files/
nul

# Temp
*.tmp
*.bak

# Documentation (keep only demo video/animation)
docs/*.md
docs/**/*.md

# Images & diagrams (not needed in release repo)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp
*.drawio
*.ico

# Exceptions: keep SVG icons required by Chainlit UI
!public/*.svg
!src/chainlit_app/public/*.svg
