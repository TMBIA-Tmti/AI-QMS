# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
chainlit_*.log
main_agent_*.log

# Data (user-generated, runtime data — NEVER commit)
data/
uploads/
markdown_storage/
regulatory_analysis_storage/
regulatory_markdown_storage/

# Cache
.ruff_cache/
.sisyphus/
.files/
nul

# Phoenix (Arize Phoenix LLM observability data)
phoenix_data/
.phoenix/
Phoenix_Integration_Report.*
generate_phoenix_report.py

# Temp
*.tmp
*.bak
%TEMP%/
# Tests
tests/
chainlit_repo/

# Changelog / document files
CHANGELOG*.md
CHANGELOG*.docx
# Documentation — keep QA docs and version update notes
docs/*
!docs/QA_*.md
!docs/v*_Update_Notes.md
!docs/v*_Update_Notes.docx

# Images & diagrams (not needed in release repo)
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp
*.drawio
*.ico

# Exceptions: keep SVG icons required by Chainlit UI
!public/*.svg
!src/chainlit_app/public/*.svg

# Video / media files
*.mp4
*.avi
*.mov
*.mkv

# Backup files
*.bak2
*.bak3
*.bak4
